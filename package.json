{
  "name": "rate-limiter-assignment",
  "version": "1.0.0",
  "description": "A Node.js / Express / TypeScript API demonstrating API throttling with two rate-limiting algorithms, two storage strategies, and per-client configurable policies.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:inspect": "tsx watch --inspect src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "npm run build && node dist/server.js",
    "clean": "rm -rf dist",
    "test": "jest --runInBand"
  },

  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "redis": "^6.2.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },

  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },

  "repository": {
    "type": "git",
    "url": "git+https://github.com/ROHAN-TANDEL/rate-limiter-assignment.git"
  },
  "keywords": [],
